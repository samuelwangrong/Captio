PLASMO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PLASMO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WebSocket URL of the deployed apps/server instance (see its Dockerfile).
# Leave unset for local dev — it falls back to ws://localhost:3001/transcribe.
# MUST be set before building the extension for real distribution (Chrome
# Web Store, etc.) — without it, captions only work for users who happen to
# be running a local dev server.
PLASMO_PUBLIC_SERVER_URL=wss://your-deployed-server.example.com/transcribe

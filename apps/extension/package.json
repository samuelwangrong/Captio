{
  "name": "extension",
  "displayName": "Captio",
  "version": "0.0.1",
  "description": "Accurate, beautiful captions for YouTube",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude test/integration/**",
    "test:integration": "vitest run test/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@captio/ui": "workspace:*",
    "@supabase/supabase-js": "^2.108.1",
    "plasmo": "0.89.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.17",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.5",
    "vitest": "^2.1.4"
  },
  "manifest": {
    "host_permissions": [
      "https://www.youtube.com/*",
      "https://captio.ai/*"
    ],
    "permissions": [
      "storage",
      "tabs",
      "activeTab",
      "tabCapture",
      "offscreen"
    ]
  }
}

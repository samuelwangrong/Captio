{
  "name": "@captio/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "verify-keys": "tsx scripts/verify-keys.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run unit.test.ts",
    "test:integration": "vitest run integration.test.ts",
    "test:e2e": "vitest run e2e.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^10.0.1",
    "@supabase/supabase-js": "^2.108.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5",
    "vitest": "^2.1.4"
  }
}

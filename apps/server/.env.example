DEEPGRAM_API_KEY=your_deepgram_api_key_here
PORT=3001
HOST=0.0.0.0

# DeepL API key, used to translate captions for the "Caption language" picker.
# Free-tier keys end in ":fx" (e.g. "abcdef01-...:fx") and automatically use
# the api-free.deepl.com endpoint — see src/translate.ts.
DEEPL_API_KEY=your_deepl_api_key_here

# Supabase JWT secret — found at supabase.com → project → Settings → API → JWT Secret.
# When set, the /transcribe WebSocket endpoint rejects connections without a valid token.
# Leave unset to bypass auth (useful for local development without a Supabase project).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
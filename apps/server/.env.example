DEEPGRAM_API_KEY=your_deepgram_api_key_here
PORT=3001
HOST=0.0.0.0

# DeepL API key, used to translate captions for the "Caption language" picker.
# Free-tier keys end in ":fx" (e.g. "abcdef01-...:fx") and automatically use
# the api-free.deepl.com endpoint — see src/translate.ts.
DEEPL_API_KEY=your_deepl_api_key_here

# Supabase project URL and anon key — same values as NEXT_PUBLIC_SUPABASE_URL/
# NEXT_PUBLIC_SUPABASE_ANON_KEY in apps/web and PLASMO_PUBLIC_SUPABASE_URL/
# PLASMO_PUBLIC_SUPABASE_ANON_KEY in apps/extension, just without those apps'
# bundler-specific prefixes. Found at supabase.com -> project -> Settings ->
# API Keys (URL + anon/publishable key).
#
# When both are set, the /transcribe WebSocket endpoint verifies every token
# by asking Supabase directly (auth.getUser) — this works regardless of
# whether the project signs tokens with the legacy shared secret or newer
# JWT Signing Keys, and needs no key management here. Leave both unset to
# bypass auth (useful for local development without a Supabase project).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Concurrent /transcribe connection caps — Deepgram/DeepL are metered APIs,
# so these bound worst-case cost from a bug or malicious actor. Optional;
# defaults to 50 total / 3 per authenticated user (see server.ts) if unset.
MAX_CONCURRENT_CONNECTIONS=50
MAX_CONCURRENT_CONNECTIONS_PER_USER=3
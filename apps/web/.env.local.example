NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — bypasses RLS, server-only, NEVER exposed to the client
# (no NEXT_PUBLIC_ prefix). Get it from Supabase Dashboard -> Settings -> API
# -> service_role secret. Only used to delete a user's own auth.users row on
# /dashboard/account (which cascades to their profile/transcripts/vocabulary
# via the migrations' `on delete cascade`). Leave unset to show a "not
# configured" state on that page instead of a broken delete button.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# YouTube Data API v3 key, used by /dashboard/explore to browse trending
# videos by region. Get one from Google Cloud Console: create a project (or
# use an existing one), enable the "YouTube Data API v3", then create an API
# key under Credentials. Leave unset to show a "not configured" state instead
# of the explore grid.
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
